# Anthropic API key — required only for "live" mode.
# The prototype defaults to MOCK mode and works fully without this.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cost-efficient model used for live calls (default: Claude Haiku 4.5).
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Daily live-AI call budget shared across /api/generate + /api/segment (default 15).
# DAILY_LIVE_LIMIT=15

# Set this to enable POST /api/usage/reset?token=... (resets today's budget to 0).
# Leave unset to keep the reset endpoint disabled (safe default).
# RESET_TOKEN=choose-a-long-random-string

# OPTIONAL — for a TRUE global/persistent daily cap on serverless (Upstash Redis
# via the Vercel integration). Without these, the cap uses an in-memory counter
# that works for local + a warm instance but can reset on cold starts.
# Vercel's Upstash integration injects these automatically (run `vercel env pull`
# to get them locally). Legacy Vercel KV names (KV_REST_API_*) are also accepted.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx
