# Anthropic API key — required only for "live" mode.
# The prototype defaults to MOCK mode and works fully without this.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cost-efficient model used for live calls (default: Claude Haiku 4.5).
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Daily live-AI call budget shared across /api/generate + /api/segment (default 15).
# DAILY_LIVE_LIMIT=15

# OPTIONAL — for a TRUE global/persistent daily cap on serverless (Vercel KV /
# Upstash Redis). Without these, the cap uses an in-memory counter that works for
# local + a warm instance but can reset on cold starts.
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxxxxxx
